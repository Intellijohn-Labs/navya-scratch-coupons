{
  "name": "genuine-draw",
  "version": "4.0.0",
  "description": "Genuine Draw — multi-merchant QR coupon & lucky-draw trust platform (super admin, merchant admin with outlets/staff, customer scratch page, tamper-evident activity log)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --no-warnings server.js",
    "dev": "node --env-file-if-exists=.env.local --no-warnings --watch server.js",
    "db:setup": "node --env-file-if-exists=.env.local --no-warnings scripts/db-setup.js",
    "super:password": "node --env-file-if-exists=.env.local --no-warnings scripts/set-super-password.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1"
  }
}
