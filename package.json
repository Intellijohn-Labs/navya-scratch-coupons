{
  "name": "scratch-and-win",
  "version": "3.0.0",
  "description": "Scratch & Win — multi-bakery QR scratch-coupon platform (super admin, bakery admin, customer scratch page)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --no-warnings server.js",
    "dev": "node --env-file-if-exists=.env.local --no-warnings --watch server.js",
    "db:setup": "node --env-file-if-exists=.env.local --no-warnings scripts/db-setup.js",
    "super:password": "node --env-file-if-exists=.env.local --no-warnings scripts/set-super-password.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1"
  }
}
