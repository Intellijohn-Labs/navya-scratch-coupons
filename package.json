{
  "name": "navya-scratch-coupons",
  "version": "2.0.0",
  "description": "Navya Bakers — Scan & Scratch QR coupon system (admin + customer scratch experience)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local --no-warnings server.js",
    "dev": "node --env-file-if-exists=.env.local --no-warnings --watch server.js",
    "db:setup": "node --env-file-if-exists=.env.local --no-warnings scripts/db-setup.js",
    "db:import-sqlite": "node --env-file-if-exists=.env.local --no-warnings scripts/import-sqlite.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1"
  }
}
